# Copy to .env on the server and fill in the real values (never commit .env).
# How to find each value: see DEPLOY.md.

# Public domain of the site (DNS A record pointing to the VPS).
SITE_DOMAIN=manga.example.com

# Name of the Docker network Traefik is attached to (docker network ls).
TRAEFIK_NETWORK=traefik-network-placeholder

# Traefik HTTPS entrypoint name (usually "websecure").
TRAEFIK_ENTRYPOINT=websecure

# Traefik certificate resolver name (e.g. the Let's Encrypt resolver).
TRAEFIK_CERTRESOLVER=letsencrypt-placeholder

# Traefik HTTP entrypoint, only used by the optional redirect labels (usually "web").
TRAEFIK_HTTP_ENTRYPOINT=web

# Image tag built/run by docker compose. Use the git commit to enable rollbacks.
IMAGE_TAG=latest

# ===================================================================================
# App features (optional). Read at request time: changing them only needs a restart.
# Missing config degrades gracefully (see README › Environment variables).
# For local development, copy just this part to .env.local.

# --- Contact form (SMTP) ------------------------------------------------------------
# Without SMTP_HOST + CONTACT_TO, /about shows a "contact us by email" fallback instead of the form.
SMTP_HOST=
# 465 = implicit TLS; anything else (587 by default) uses STARTTLS when the server offers it.
SMTP_PORT=587
# Leave user/pass empty for servers without auth (e.g. a local catcher like Mailpit on port 1025).
SMTP_USER=
SMTP_PASS=
# Sender address; defaults to SMTP_USER, then CONTACT_TO. Must be allowed by your SMTP provider.
SMTP_FROM=
# Where contact messages are delivered (the visitor's address is set as Reply-To).
CONTACT_TO=

# --- Newsletter (Brevo) -------------------------------------------------------------
# Without both values the newsletter signup is hidden everywhere.
# API key: Brevo › SMTP & API › API keys. List id: Contacts › Lists (numeric id).
BREVO_API_KEY=
BREVO_LIST_ID=
